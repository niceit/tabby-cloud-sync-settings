.modal-header
    .d-flex.align-items-center
        .dropbox-secret-modal__icon
            i.fas.fa-lock(aria-hidden='true')
        h4.modal-title.mb-0([textContent]='translate.trans("dropbox.encryption_secret_title")')
    button.dropbox-secret-modal__close(
        type='button',
        (click)='cancel()',
        [disabled]='isProcessing',
        [attr.aria-label]='translate.trans("buttons.cancel")',
    )
        i.fas.fa-times(aria-hidden='true')

.modal-body
    p.dropbox-secret-modal__description([textContent]='translate.trans("dropbox.encryption_secret_required")')
    label(
        for='dropbox-encryption-secret-modal-input',
        [textContent]='translate.trans("dropbox.encryption_secret_label")',
    )
    .dropbox-secret-modal__input
        input.form-control(
            id='dropbox-encryption-secret-modal-input',
            #secretInput,
            [type]='showSecret ? "text" : "password"',
            autocomplete='current-password',
            [(ngModel)]='secret',
            [placeholder]='translate.trans("dropbox.encryption_secret_placeholder")',
            [disabled]='isProcessing',
            (keyup.enter)='submit()',
            (keyup.esc)='cancel()',
        )
        button.dropbox-secret-modal__toggle(
            type='button',
            (click)='toggleSecretVisibility()',
            [attr.aria-label]='translate.trans(showSecret ? "settings.encryption_hide_secret" : "settings.encryption_show_secret")',
            [attr.title]='translate.trans(showSecret ? "settings.encryption_hide_secret" : "settings.encryption_show_secret")',
            aria-controls='dropbox-encryption-secret-modal-input',
            [attr.aria-pressed]='showSecret',
        )
            i.fas.fa-eye(*ngIf='!showSecret', aria-hidden='true')
            i.fas.fa-eye-slash(*ngIf='showSecret', aria-hidden='true')

    .alert.alert-danger.mt-3.mb-0(*ngIf='errorMessage', role='alert')
        i.fas.fa-exclamation-circle.mr-2(aria-hidden='true')
        span([textContent]='errorMessage')

.modal-footer
    button.btn.btn-secondary.btn-sm(
        type='button',
        (click)='cancel()',
        [disabled]='isProcessing',
        [textContent]='translate.trans("buttons.cancel")',
    )
    button.btn.btn-primary.btn-sm(
        type='button',
        (click)='submit()',
        [disabled]='!secret || isProcessing',
    )
        i.fas.fa-unlock-alt.mr-2(*ngIf='!isProcessing', aria-hidden='true')
        span.spinner-border.spinner-border-sm.mr-2(*ngIf='isProcessing')
        span([textContent]='translate.trans(isProcessing ? "dropbox.encryption_unlocking" : "dropbox.encryption_unlock")')
