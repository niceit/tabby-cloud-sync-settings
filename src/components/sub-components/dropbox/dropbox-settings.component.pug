.form-group(*ngIf='!connectedData.isConnected')
    .header.mb-2
        .title(*ngIf='!isConnecting', [textContent]='translate.trans("dropbox.title")')
        .title(*ngIf='isConnecting', [textContent]='translate.trans("dropbox.title_connecting")')

.row(*ngIf='!connectedData.isConnected')
    .col-md-12.mb-2(*ngIf='!isConnecting')
        button.btn.btn-primary.flex-shrink-0.ml-3.mb-2((click)='connect()')
            i.fa.fa-brands.fa-dropbox.mr-2
            span([textContent]='translate.trans("buttons.connect")')

.row(*ngIf='!connectedData.isConnected && !isSaveSettingErrored')
    .col-md-12.mb-2(*ngIf='isConnecting')
        button.btn.btn-warning.flex-shrink-0.ml-3.mb-2((click)='cancelConnect()')
            span.spinner-border.spinner-border-sm.mr-2
            span([textContent]='translate.trans("buttons.cancel")')

    .col-md-12.mb-2(*ngIf='isConnecting && isAutomaticCallbackAvailable && !showManualCallbackFallback')
        .alert.alert-info.ml-3
            i.fas.fa-external-link-alt.mr-2
            span([textContent]='translate.trans("dropbox.callback_waiting")')
        button.btn.btn-secondary.flex-shrink-0.ml-3.mb-2((click)='enableManualCallback()')
            i.fa.fa-keyboard.mr-2
            span([textContent]='translate.trans("dropbox.use_manual_callback")')

    .col-md-12.mb-2(*ngIf='isConnecting && !isAutomaticCallbackAvailable && showManualCallbackFallback')
        .alert.alert-warning.ml-3
            i.fas.fa-exclamation-triangle.mr-2
            span([textContent]='translate.trans("dropbox.callback_listener_unavailable")')

    .col-md-12.mb-2(*ngIf='isConnecting && showManualCallbackFallback')
        .w-100.d-flex.flex-column
            h3([textContent]='translate.trans("dropbox.callback_title")')
            p([textContent]='translate.trans("dropbox.callback_hint")')
            textarea.form-control.h-150(
                [(ngModel)]='callbackUrl',
            )

    .col-md-12.mb-2(*ngIf='isConnecting && showManualCallbackFallback')
        button.btn.btn-primary.flex-shrink-0.ml-3.mb-2.mr-2((click)='!isFormProcessing ? handleAuthCallback() : null')
            i.fa.fa-brands.fa-dropbox.mr-2(*ngIf='!isFormProcessing')
            span(*ngIf='!isFormProcessing', [textContent]='translate.trans("dropbox.obtain_token")')
            span.spinner-border.spinner-border-sm.mr-2(*ngIf='isFormProcessing')
            span(*ngIf='isFormProcessing', [textContent]='translate.trans("dropbox.obtaining_token")')

        button.btn.btn-warning.flex-shrink-0.ml-3.mb-2((click)='pasteFromClipboard()')
            i.fa.fa-paste.mr-2
            span([textContent]='translate.trans("dropbox.paste_from_clipboard")')


.row(*ngIf='connectedData.isConnected && !isSaveSettingErrored')
    .col-md-12.mb-2
        .alert.alert-success
            p.mb-2
                i.fas.fa-info-circle.mr-2
                span([textContent]='connectedLabel')

    .col-md-12.mb-2(*ngIf='connectedData.lastErrorMessage')
        .alert.alert-warning
            p.mb-2
                i.fas.fa-info-circle.mr-2
                span([textContent]='lastSyncErrorLabel')


    .col-md-12.mb-2(*ngIf='isSettingSaved')
        button.btn.btn-danger.flex-shrink-0.ml-3((click)='disconnectSettings()')
            i.fa.fa-fw.fa-sign-out-alt.mr-2
            span([textContent]='translate.trans("dropbox.disconnect_account")')

    .col-md-12.mb-2(*ngIf='!isSettingSaved')
        button.btn.btn-warning.flex-shrink-0.ml-3.mr-2((click)='saveSettings()')
            i.fa.fa-fw.fa-save.mr-2
            span([textContent]='translate.trans("buttons.save_settings")')

        button.btn.btn-danger.flex-shrink-0.ml-3((click)='disconnect()')
            i.fa.fa-fw.fa-sign-out-alt.mr-2
            span([textContent]='translate.trans("buttons.disconnect")')
