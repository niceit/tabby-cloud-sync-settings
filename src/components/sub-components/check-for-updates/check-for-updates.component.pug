.row.pb-1.has-border-top.mt-3.pt-3
    .col-md-12
        h3([textContent]='translate.trans("updates.title")')
    .col-md-12.mb-2
        .alert.alert-warning
            p.mb-0
                i.fas.fa-info-circle.mr-2
                span([textContent]='currentVersionMessage')
            p.mb-0
                i.fas.fa-info-circle.mr-2
                span([textContent]='translate.trans("updates.check_hint")')

    .col-md-12.pt-3.text-right
        button.btn.btn-warning.flex-shrink-0.ml-3.mb-2(
            (click)='checkForPluginVersion().then()',
            [disabled]='isProcessingRequest',
        )
            i.fas.fa-plug.mr-2
            span(*ngIf="!isProcessingRequest", [textContent]='translate.trans("buttons.check_update")')
            span(*ngIf="isProcessingRequest", [textContent]='translate.trans("buttons.processing")')

    .col-md-12.mt-2(*ngIf='isUpdateAvailable')
        .alert.alert-warning
            p.mb-0([textContent]='latestVersionMessage')
            h3([textContent]='translate.trans("updates.whats_new")')
            .mt-2(*ngFor="let news of newVersionData.what_news")
                h4 {{news.title}}
                p.mb-0(*ngFor="let item of news.content" ) {{item}}

        button.btn.btn-primary.flex-shrink-0.ml-3.mb-2(*ngIf="!errorCheckForUpdates || !isSuccessPluginUpgrade" , (click)='upgradePlugin()')
            i.fas.fa-cloud-download.mr-2
            span(*ngIf="!isUpdatingPlugin", [textContent]='updateButtonLabel')
            span(*ngIf="isUpdatingPlugin", [textContent]='translate.trans("buttons.processing")')

.row.pb-1.has-border-top.mt-3.pt-3
    .col-md-12
        h3([textContent]='translate.trans("updates.rollback_title")')

    .col-md-12.mb-2
        .alert.alert-warning
            p.mb-2
                i.fas.fa-exclamation-triangle.mr-2
                span([textContent]='translate.trans("updates.rollback_warning_backup")')
            p.mb-0
                i.fas.fa-exclamation-triangle.mr-2
                span([textContent]='translate.trans("updates.rollback_warning_risk")')

    .col-md-12
        table.table.table-striped.table-bordered.table-hover.table-sm
            thead
                tr
                    th([textContent]='translate.trans("updates.column_version")')
                    th([textContent]='translate.trans("updates.column_action")')
            tbody
                tr(*ngFor="let version of availableRollbackBuilds")
                    td {{version}}
                    td
                        button.btn.btn-warning.btn-sm.flex-shrink-0.ml-3.mb-2(
                            (click)='confirmRollbackToVersion(version).then()',
                            [disabled]='isUpdatingPlugin',
                        )
                            i.fas.fa-undo.mr-2
                            span(*ngIf="!isUpdatingPlugin || targetRollbackVersion != version", [textContent]='translate.trans("buttons.rollback")')
                            span(*ngIf="isUpdatingPlugin && targetRollbackVersion == version", [textContent]='translate.trans("buttons.processing")')
