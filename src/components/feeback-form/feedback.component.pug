.row.pb-1.has-border-top.mt-3.pt-3
    .col-md-12
        h3([textContent]='translate.trans("feedback.title")')
    .col-md-12
        p.mb-0([textContent]='translate.trans("feedback.description")')
        p.mt-0.pt-0([textContent]='translate.trans("feedback.description_2")')
        p.mt-0.pt-0.text-muted([textContent]='translate.trans("feedback.open_issue_hint")')
    .col-md-12.pt-2
        button.btn.btn-warning.flex-shrink-0.mb-2((click)='openIssuesPage()')
            i.fab.fa-fw.fa-github.mr-2
            span([textContent]='translate.trans("buttons.open_github_issue")')
